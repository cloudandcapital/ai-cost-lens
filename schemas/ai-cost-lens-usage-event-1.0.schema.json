{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudandcapital.com/schemas/ai-cost-lens-usage-event-1.0.schema.json",
  "title": "AI Cost Lens canonical usage event 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "event_id", "timestamp", "provider", "billing_channel", "model", "project",
    "team_owner", "feature", "customer", "product", "workload", "workflow", "session_id", "environment", "customer_product", "input_tokens", "output_tokens", "reasoning_tokens",
    "cached_input_tokens", "cache_write_tokens", "cache_write_duration_seconds", "batch", "tool_charges",
    "provider_reported_cost", "calculated_cost", "selected_cost", "cost_basis", "currency", "request_status",
    "retry_parent_event_id", "latency_ms", "evidence_source", "source_file_hash", "prefix_fingerprint",
    "tool_call_count", "outcome_status", "duplicate_group"
  ],
  "properties": {
    "schema_version": { "const": "ai-cost-lens-usage-event/1.0" },
    "record_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": ["string", "null"] },
    "timestamp": { "type": ["string", "null"], "format": "date-time" },
    "provider": { "type": ["string", "null"] },
    "billing_channel": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "project": { "type": ["string", "null"] },
    "team_owner": { "type": ["string", "null"] },
    "feature": { "type": ["string", "null"] },
    "customer": { "type": ["string", "null"] },
    "product": { "type": ["string", "null"] },
    "workload": { "type": "string", "minLength": 1 },
    "workflow": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "environment": { "type": ["string", "null"] },
    "customer_product": { "type": ["string", "null"] },
    "input_tokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
    "output_tokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
    "reasoning_tokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
    "cached_input_tokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
    "cache_write_tokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
    "cache_write_duration_seconds": { "$ref": "#/$defs/nullableNonnegativeNumber" },
    "batch": { "type": ["boolean", "null"] },
    "tool_charges": { "$ref": "#/$defs/nullableNonnegativeNumber" },
    "provider_reported_cost": { "$ref": "#/$defs/nullableNonnegativeNumber" },
    "calculated_cost": { "$ref": "#/$defs/nullableNonnegativeNumber" },
    "selected_cost": { "$ref": "#/$defs/nullableNonnegativeNumber" },
    "cost_basis": { "enum": ["provider_reported", "calculated", "unpriced"] },
    "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
    "request_status": { "enum": ["success", "failed", "cancelled", "retried", "unknown", null] },
    "retry_parent_event_id": { "type": ["string", "null"] },
    "latency_ms": { "$ref": "#/$defs/nullableNonnegativeNumber" },
    "evidence_source": { "type": ["string", "null"] },
    "source_file_hash": { "type": ["string", "null"] },
    "prefix_fingerprint": { "type": ["string", "null"] },
    "tool_call_count": { "$ref": "#/$defs/nullableNonnegativeInteger" },
    "outcome_status": { "type": ["string", "null"] },
    "duplicate_group": { "type": ["string", "null"] }
  },
  "$defs": {
    "nullableNonnegativeInteger": { "type": ["integer", "null"], "minimum": 0 },
    "nullableNonnegativeNumber": { "type": ["number", "null"], "minimum": 0 }
  }
}
