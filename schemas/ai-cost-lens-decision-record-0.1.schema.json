{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudandcapital.com/schemas/ai-cost-lens-decision-record-0.1.schema.json",
  "title": "AI Cost Lens Decision Record 0.1",
  "description": "A portable, evidence-aware finance decision about an AI workload.",
  "type": "object",
  "required": [
    "schema_version",
    "record_profile",
    "decision_id",
    "recorded_at",
    "mode",
    "question",
    "title",
    "workload",
    "decision",
    "routes",
    "comparison",
    "claims",
    "evidence",
    "limitations",
    "consistency_checks",
    "next_test"
  ],
  "properties": {
    "schema_version": { "const": "ai-cost-lens-decision-record/0.1" },
    "record_profile": { "const": "model_route/0.1" },
    "decision_id": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "minLength": 1 },
    "mode": {
      "enum": ["real", "controlled_synthetic_pilot", "illustrative"]
    },
    "question": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "workload": { "type": "object" },
    "decision": { "type": "object" },
    "routes": { "type": "object" },
    "comparison": { "type": "object" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "limitations": { "type": "array" },
    "consistency_checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consistencyCheck" }
    },
    "next_test": { "type": "object" }
  },
  "$defs": {
    "state": {
      "enum": [
        "VERIFIED_FACT",
        "LIMITED_EVIDENCE",
        "COMPANY_CLAIM",
        "ESTIMATE",
        "UNKNOWN",
        "CONTRADICTED"
      ]
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "statement", "state", "source_ids", "blocked_by"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/state" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_by": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "topic", "state", "value", "detail", "source"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/state" },
        "value": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "metric": {
      "type": "object",
      "required": ["label", "value", "unit"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "consistencyCheck": {
      "type": "object",
      "required": [
        "check_id",
        "status",
        "material",
        "left",
        "right",
        "source_ids"
      ],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "NOT_TESTED"] },
        "material": { "type": "boolean" },
        "left": { "$ref": "#/$defs/metric" },
        "right": { "$ref": "#/$defs/metric" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
